<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="400.0"
            minWidth="350.0"
            prefHeight="600.0"
            prefWidth="400.0"
            style="-fx-background-color: #f5f5f5;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    hbarPolicy="NEVER"
                    fitToWidth="true"
                    style="-fx-background: #f5f5f5; -fx-background-color: #f5f5f5;"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="45.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="10.0"
                      style="-fx-background-color: #f5f5f5; -fx-padding: 10px;" />
            </content>
        </ScrollPane>

        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="45.0"
                   promptText="Type your command here..."
                   style="-fx-font-size: 14px; -fx-padding: 10px;"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="80.0" />

        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="45.0"
                prefWidth="80.0"
                style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"
                text="Send"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.rightAnchor="0.0" />
    </children>
</AnchorPane>
