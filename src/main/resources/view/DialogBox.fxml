<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root
        alignment="TOP_RIGHT"
        maxWidth="1.7976931348623157E308"
        spacing="8.0"
        type="javafx.scene.layout.HBox"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label
                fx:id="dialog"
                text="Label"
                wrapText="true"
                minHeight="-Infinity"
                style="-fx-background-color: white; -fx-background-radius: 10px; -fx-padding: 12px; -fx-font-size: 13px; -fx-text-fill: #333333; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);" />
        <ImageView
                fx:id="displayPicture"
                fitHeight="40.0"
                fitWidth="40.0"
                pickOnBounds="true"
                preserveRatio="true" />
    </children>
    <padding>
        <Insets
                bottom="5.0"
                left="10.0"
                right="10.0"
                top="5.0" />
    </padding>
</fx:root>
